# Copy to server/.secrets (ignored by git) and fill in. Generate each token with:
#   openssl rand -hex 16
# Then store the three tokens as Worker secrets:
#   npx wrangler secret put INGEST_TOKEN   (and READ_TOKEN, SHARE_TOKEN)
INGEST_TOKEN=
READ_TOKEN=
SHARE_TOKEN=
# Your Worker address, for example https://health-bridge.<your-subdomain>.workers.dev
SERVER_URL=
# Optional: your own morning briefing receiver (see README). Leave empty to disable.
BRIEFING_URL=
BRIEFING_TOKEN=
